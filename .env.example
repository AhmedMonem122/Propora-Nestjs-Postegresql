# Database (Neon serverless PostgreSQL)
DATABASE_URL="postgres://propora_user:password@ep-xxxxx.eu-central-2.aws.neon.tech/propora?sslmode=require"

# Server
PORT=3000
NODE_ENV=development

# Auth
JWT_ACCESS_SECRET="change-me-to-a-long-random-string-min-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
BCRYPT_SALT_ROUNDS=12

# Seed (used by `npm run db:seed` only)
SUPER_ADMIN_EMAIL="admin@propora.io"
SUPER_ADMIN_PASSWORD="admin123456"
DEMO_ORGANIZATION="true"

# API docs
SWAGGER_ENABLED="true"

# CORS (allowed web origins, comma separated)
CORS_ORIGIN="*"

# Supabase (file storage for documents)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_BUCKET="documents"
