# Database (Neon serverless PostgreSQL)
DATABASE_URL="postgres://propora_user:password@ep-xxxxx.eu-central-2.aws.neon.tech/propora?sslmode=require"

# Server
PORT=3000
NODE_ENV=development

# Auth
JWT_ACCESS_SECRET="change-me-to-a-long-random-string-min-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
BCRYPT_SALT_ROUNDS=12
# Public signup on/off (register only ever creates an organization + owner)
REGISTRATION_ENABLED="true"
# Password-reset OTP lifetime (minutes) and max verify attempts
PASSWORD_RESET_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Seed (used by `npm run db:seed` only)
SUPER_ADMIN_EMAIL="admin@propora.io"
SUPER_ADMIN_PASSWORD="admin123456"
DEMO_ORGANIZATION="true"

# API docs
SWAGGER_ENABLED="true"

# Cookies (use "none" + https when the dashboard is on another origin)
COOKIE_SAMESITE="lax"

# CORS (allowed web origins, comma separated)
CORS_ORIGIN="*"

# Realtime ("supabase" broadcast works everywhere incl. Vercel;
# add "socketio" for long-lived servers: REALTIME_TRANSPORT="supabase,socketio")
REALTIME_TRANSPORT="supabase"

# Email ("auto" prefers SMTP when set, falls back to Brevo API;
# force with MAIL_TRANSPORT="smtp" or "brevo")
MAIL_TRANSPORT="auto"
# SMTP relay (Brevo free tier: host smtp-relay.brevo.com, port 587,
# user = your login email, pass = SMTP key from the Brevo dashboard)
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
# Brevo HTTP API alternative (v3 API key, starts with xkeysib-)
BREVO_API_KEY=""
MAIL_FROM_EMAIL="no-reply@propora.io"
MAIL_FROM_NAME="Propora"

# Payments ("auto" = Stripe when keys exist, otherwise Fake offline provider;
# force with PAYMENTS_PROVIDER="stripe" or "fake")
PAYMENTS_PROVIDER="auto"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
FRONTEND_URL="http://localhost:3000"
APP_PUBLIC_URL="http://localhost:3000"

# Observability (warn on DB queries slower than this, milliseconds)
SLOW_QUERY_MS=500

# Supabase (file storage for documents)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_BUCKET="documents"
