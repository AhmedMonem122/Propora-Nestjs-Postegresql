doctype html
html
  head
    meta(charset='utf-8')
    meta(name='viewport' content='width=device-width, initial-scale=1')
    title You are invited to #{organizationName}
  body(style='margin:0;padding:0;background-color:#f4f6fb;font-family:Arial,Helvetica,sans-serif;')
    table(width='100%' cellpadding='0' cellspacing='0' style='background-color:#f4f6fb;padding:32px 0;')
      tr
        td(align='center')
          table(width='600' cellpadding='0' cellspacing='0' style='background-color:#ffffff;border-radius:12px;overflow:hidden;')
            tr
              td(style='background-color:#1d4ed8;padding:28px 32px;color:#ffffff;')
                div(style='font-size:24px;font-weight:bold;') Propora
                div(style='font-size:13px;opacity:0.85;margin-top:4px;') Better Properties. Happier Communities.
            tr
              td(style='padding:32px;color:#1f2937;')
                h1(style='font-size:22px;margin:0 0 12px;') Hi #{firstName}, you are invited!
                p(style='font-size:15px;line-height:1.6;') You have been added to <strong>#{organizationName}</strong> on Propora. Your account email is <strong>#{email}</strong>.
                if temporaryPassword
                  p(style='font-size:15px;line-height:1.6;') Use this temporary password to sign in for the first time, then change it immediately:
                  p(style='font-size:18px;font-weight:bold;letter-spacing:1px;background:#f3f4f6;padding:12px;border-radius:8px;text-align:center;') #{temporaryPassword}
                else
                  p(style='font-size:15px;line-height:1.6;') Ask your administrator for sign-in instructions if you do not have a password yet.
            tr
              td(style='padding:20px 32px;background-color:#f9fafb;color:#9ca3af;font-size:12px;text-align:center;') &copy; Propora &mdash; Property Management SaaS
