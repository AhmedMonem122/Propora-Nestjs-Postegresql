doctype html
html
  head
    meta(charset='utf-8')
    meta(name='viewport' content='width=device-width, initial-scale=1')
    title Security alert: password changed
  body(style='margin:0;padding:0;background-color:#f4f6fb;font-family:Arial,Helvetica,sans-serif;')
    table(width='100%' cellpadding='0' cellspacing='0' style='background-color:#f4f6fb;padding:32px 0;')
      tr
        td(align='center')
          table(width='600' cellpadding='0' cellspacing='0' style='background-color:#ffffff;border-radius:12px;overflow:hidden;')
            tr
              td(style='background-color:#b91c1c;padding:28px 32px;color:#ffffff;')
                div(style='font-size:24px;font-weight:bold;') Security alert
                div(style='font-size:13px;opacity:0.85;margin-top:4px;') Propora account protection
            tr
              td(style='padding:32px;color:#1f2937;')
                p(style='font-size:15px;line-height:1.6;') The password for <strong>#{email}</strong> was just changed. All other sessions were signed out automatically.
                p(style='font-size:15px;line-height:1.6;font-weight:bold;') If this was not you, reset your password immediately and contact your administrator.
            tr
              td(style='padding:20px 32px;background-color:#f9fafb;color:#9ca3af;font-size:12px;text-align:center;') &copy; Propora &mdash; Property Management SaaS
