  "roleTemplates": [
    {
      "name": "ORGANIZATION_OWNER",
      "description": "Full access to everything inside the organization",
      "permissions": ["*"]
    },
    {
      "name": "PROPERTY_MANAGER",
      "description": "Manages properties, buildings, units, residents, leases and maintenance",
      "permissions": [
        "organization:read",
        "property:read", "property:create", "property:update", "property:delete",
        "building:read", "building:create", "building:update", "building:delete",
        "unit:read", "unit:create", "unit:update", "unit:delete",
        "resident:read", "resident:create", "resident:update", "resident:delete",
        "lease:read", "lease:create", "lease:update", "lease:delete",
        "maintenance:read", "maintenance:create", "maintenance:update", "maintenance:delete", "maintenance:assign",
        "document:read", "document:create", "document:update", "document:delete",
        "notification:read", "notification:update"
      ]
    },
    {
      "name": "MAINTENANCE_MANAGER",
      "description": "Handles maintenance requests, work orders and technicians",
      "permissions": [
        "organization:read",
        "property:read",
        "building:read",
        "unit:read", "unit:update",
        "resident:read",
        "maintenance:read", "maintenance:create", "maintenance:update", "maintenance:delete", "maintenance:assign",
        "document:read", "document:create",
        "notification:read", "notification:update"
      ]
    },
    {
      "name": "ACCOUNTANT",
      "description": "Handles rent, payments, invoices and financial reports",
      "permissions": [
        "organization:read",
        "resident:read",
        "unit:read",
        "lease:read", "lease:create", "lease:update",
        "payment:read", "payment:create", "payment:update", "payment:delete",
        "report:financial", "report:occupancy",
        "document:read",
        "notification:read"
      ]
    },
    {
      "name": "STAFF",
      "description": "Read-only access to the property portfolio",
      "permissions": [
        "property:read",
        "building:read",
        "unit:read",
        "resident:read",
        "lease:read",
        "maintenance:read",
        "notification:read"
      ]
    }
  ],
  "platformAdminRole": {
    "name": "PLATFORM_ADMIN",
    "description": "Propora platform administrator (not bound to any organization)",
    "permissions": ["*"]
  }
}
